"""Task:  
    Write a function that:
    Accepts any number of numbers
    Returns the maximum value
"""

def max_value(*nums) -> int: 
    max_num = max(nums)
    
    if not nums:
        raise ValueError("At least one number is required")
    
    return max_num
    
result = max_value(3, 7, 2, 9)  # → 9
print(result)

