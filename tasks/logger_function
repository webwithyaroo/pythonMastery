"""🔹 Drill 6 — Real Backend Pattern"""


def api_handler(endpoint: str, method: str ="GET", *args, **kwargs):
    header = ", ".join([endpoint] + [method])
    extra_arg = ", ".join(args)
    
    context = [f"{key}, {value}" for key, value in kwargs.items() if value and key]
    return "\n".join([header, extra_arg, *context]) 
    
    
