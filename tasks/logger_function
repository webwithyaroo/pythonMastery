"""🔹 Drill 4 — Filtering Context (Real Skill)"""

def logger(*messages, **context):
    msg = ", ".join(messages)
    ctxt = [f"{key}, {value}" for key, value in context.items() if value and key]

    return "\n".join([msg, *ctxt])
    
    
result4 = logger(
    "Login attempt",
    user="yaroo",
    ip=None,
    device="mobile"
)


